// make wrapper static lib
java_library {
    name: "qti_soundrecorder_wrapper",
    srcs: ["src-Wrapper/**/*.java"],

    sdk_version: "current",

}

prebuilt_etc {
    name: "privapp_whitelist_com.android.soundrecorder",

    src: "privapp-permissions-soundrecorder.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
    filename_from_src: true,
}

android_app {
    name: "QtiSoundRecorder",

    srcs: [
        "**/*.java",
        "**/*.kt",
    ],

    resource_dirs: ["res"],

    aaptflags: ["--auto-add-overlay"] + ["--extra-packages"] + ["androidx.recyclerview_recyclerview"],


    static_libs: [
        "androidx.recyclerview_recyclerview",
        "androidx.core_core",
        "qti_soundrecorder_wrapper",
        "androidx-constraintlayout_constraintlayout",
        "gson",
        "vendor.qti.hardware.c2pa-V1-java",
    ],
    required: ["privapp_whitelist_com.android.soundrecorder"],

    overrides: ["SoundRecorder"],

    system_ext_specific: true,
    platform_apis: true,

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },

    use_embedded_native_libs: true,
    privileged: true,
    jni_libs: ["libjni_recorderutils"],

}

cc_library_shared {
    name: "libjni_recorderutils",
    srcs: ["jni/recorder_utils_jni.cpp"],
    cflags: [
        "-ffast-math",
        "-O3",
        "-funroll-loops",
    ],
    header_libs: [
        "jni_headers",
        "libnativewindow_headers",
    ],
    static_libs: [
        "libaidlcommonsupport",
        "android.hardware.common-V2-ndk",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libbinder_ndk",
        "libutils",
        "libnativewindow",
    ],
}

